# Environment Configuration Template for Flyway
# Copy this file and rename to .env.local (for local development)
# DO NOT commit actual credentials to the repository

# ===========================================
# Development Environment (Default)
# ===========================================
FLYWAY_DB_HOST=oracle-config.bsi.regla.cloud
FLYWAY_DB_PORT=1521
FLYWAY_DB_SID=REGLA_DEV_BSI_CONFIG
FLYWAY_DB_USER=system
FLYWAY_DB_PASSWORD=<YOUR_PASSWORD_HERE>

# ===========================================
# Staging Environment
# ===========================================
# FLYWAY_DB_HOST_STAGING=<staging-host>
# FLYWAY_DB_PORT_STAGING=1521
# FLYWAY_DB_SID_STAGING=<staging-sid>
# FLYWAY_DB_USER_STAGING=<staging-user>
# FLYWAY_DB_PASSWORD_STAGING=<staging-password>

# ===========================================
# Production Environment
# ===========================================
# FLYWAY_DB_HOST_PROD=<production-host>
# FLYWAY_DB_PORT_PROD=1521
# FLYWAY_DB_SID_PROD=<production-sid>
# FLYWAY_DB_USER_PROD=<production-user>
# FLYWAY_DB_PASSWORD_PROD=<production-password>
